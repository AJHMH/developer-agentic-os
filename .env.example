# Developer Workflow OS v2 - Environment Template
#
# Copy this file to `.env` and fill in the values you need. The app runs
# fully with no environment variables at all: Local Git works out of the
# box, and every other integration shows as "unconfigured" or "deferred" in
# the Integration Operations panel until you supply credentials.
#
# See docs/getting-started.md for step-by-step token instructions.

# ---------------------------------------------------------------------------
# GitHub (Integration Operations: issues, pull requests, Actions, merge status)
# ---------------------------------------------------------------------------
# A personal access token with `repo` (classic) or "Contents/Issues/Pull
# requests/Actions: Read-only" (fine-grained) scope. Only one of the two
# token variables is required.
GITHUB_TOKEN=ghp_your_github_token_here
# GH_TOKEN=ghp_your_github_token_here

# Repository the token should operate against, as "owner/repo". If omitted,
# GITHUB_OWNER + GITHUB_REPO are used instead, or the local Git remote origin.
GITHUB_REPOSITORY=your-org/your-repo
# GITHUB_OWNER=your-org
# GITHUB_REPO=your-repo

# Override only if you use GitHub Enterprise Server.
# GITHUB_API_URL=https://github.yourcompany.com/api/v3

# Hosted multi-tenant entitlement checks (ADR 0002):
# - GITHUB_ORG sets one required org for all tenants.
# - GITHUB_ORG_MAP can override per Clerk org/tenant id.
#   Example: {"org_abc123":"acme-corp","org_def456":"stripe-eng"}
# GITHUB_ORG=acme-corp
# GITHUB_ORG_MAP={"org_abc123":"acme-corp"}

# ---------------------------------------------------------------------------
# Vercel (Integration Operations: deployments, build/runtime logs)
# ---------------------------------------------------------------------------
# A Vercel access token. Only one of the two token variables is required.
VERCEL_TOKEN=your_vercel_token_here
# VERCEL_API_TOKEN=your_vercel_token_here

# The Vercel project to report on. If this repo has already been linked with
# `vercel link`, the project id/team id are read from .vercel/project.json
# and these variables are optional.
VERCEL_PROJECT_ID=your_vercel_project_id
VERCEL_TEAM_ID=your_vercel_team_id

# Set to "false" to turn the Vercel panel off entirely (shows as "disabled").
# VERCEL_INTEGRATION_ENABLED=true

# ---------------------------------------------------------------------------
# Email (Integration Operations: read-only signal sync)
# ---------------------------------------------------------------------------
# Email has no live provider yet. Leaving EMAIL_PROVIDER unset runs a local
# demo mode with sample messages. Set EMAIL_PROVIDER to any label to mark the
# adapter as "configured", and EMAIL_PROVIDER_DATA to a JSON array of
# { "id", "subject", "sender", "body" } messages to feed it real data.
# EMAIL_PROVIDER=demo
# EMAIL_PROVIDER_DATA=[]

# Set to "false" to turn the Email panel off entirely (shows as "disabled").
# EMAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Staged integrations (deferred)
# ---------------------------------------------------------------------------
# Sentry, Cloudflare, CodeRabbit, WorkOS, Clerk, Convex, NeonDB, Upstash, and
# Slack appear in the Integration Operations panel as staged/"deferred"
# health states. They do not read any environment variables yet; there is
# nothing to configure for them until a later milestone wires them up.
