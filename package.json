{
  "name": "developer-agentic-os-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ruleset:sync": "tsx scripts/sync-ruleset.ts",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test --config=playwright.hosted.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.1",
    "@neondatabase/serverless": "1.1.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
